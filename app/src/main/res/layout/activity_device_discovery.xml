<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_radar_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/deviceScanStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/scan_status_idle"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/themeToggleButton"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/toggle_theme"
            app:icon="@android:drawable/ic_menu_manage"
            app:iconTint="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- RADAR VISUAL -->
    <com.google.android.material.card.MaterialCardView
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="18dp"
        app:cardCornerRadius="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- PULSE 1 -->
            <View
                android:id="@+id/scanPulse1"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/scan_pulse_bg" />

            <!-- PULSE 2 -->
            <View
                android:id="@+id/scanPulse2"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/scan_pulse_bg" />

            <!-- CENTER RADAR ICON -->
            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardCornerRadius="36dp"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                app:strokeWidth="0dp"
                android:elevation="6dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/stat_sys_data_bluetooth"
                    app:tint="?attr/colorOnPrimary" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="16dp"
                android:text="@string/device_radar_subtitle"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SCAN ACTION BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/scanButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/start_scan"
        android:textAllCaps="false"
        app:cornerRadius="24dp"
        app:icon="@android:drawable/stat_notify_sync"
        app:iconGravity="textStart"
        app:iconPadding="10dp" />

    <!-- DEVICE LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/deviceRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1" />

    <!-- SYSTEM PAIR BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/systemPairButton"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="Pair Unpaired Device (System)"
        android:textAllCaps="false"
        app:cornerRadius="12dp"
        app:icon="@android:drawable/ic_menu_add"
        app:iconGravity="textStart"
        app:iconPadding="10dp" />

</LinearLayout>
