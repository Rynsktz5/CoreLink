<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surfaceElevated"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/chat_status_not_connected"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/themeToggleButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/icon_btn_bg"
                android:contentDescription="@string/toggle_theme"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_manage"
                android:tint="@color/textPrimary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/connectBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/icon_btn_bg"
                android:contentDescription="@string/connect_mode_title"
                android:padding="12dp"
                android:src="@android:drawable/stat_sys_data_bluetooth"
                android:tint="@color/textPrimary" />

            <ImageButton
                android:id="@+id/micBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/icon_btn_bg"
                android:contentDescription="@string/voice_prompt"
                android:padding="12dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="@color/textPrimary" />

            <ImageButton
                android:id="@+id/callBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/icon_btn_bg"
                android:contentDescription="@string/calling_coming_soon"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_call"
                android:tint="@color/textPrimary" />

            <ImageButton
                android:id="@+id/emergencyBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/alert_btn_bg"
                android:contentDescription="@string/default_emergency_alert"
                android:padding="12dp"
                android:src="@android:drawable/ic_dialog_alert"
                android:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">

        <EditText
            android:id="@+id/chatInput"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/input_bg"
            android:gravity="center_vertical"
            android:hint="@string/chat_hint"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textMuted" />

        <ImageButton
            android:id="@+id/sendBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/send_btn_bg"
            android:contentDescription="@string/send_message"
            android:padding="16dp"
            android:src="@android:drawable/ic_menu_send"
            android:tint="@android:color/white" />
    </LinearLayout>

</LinearLayout>
